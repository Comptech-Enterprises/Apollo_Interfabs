generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  SALES
}

model User {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model Sku {
  id                   String        @id @default(auto()) @map("_id") @db.ObjectId
  code                 String        @unique
  fabricName           String
  fabricType           String
  colour               String
  pattern              String?
  otherIdentifiers     String?
  sellingPricePerMetre Float
  lowStockThreshold    Float         @default(0)
  currentStock         Float         @default(0)
  active               Boolean       @default(true)
  createdById          String        @db.ObjectId
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  stockIns             StockIn[]
  sales                Sale[]
  prices               PriceChange[]

  @@index([fabricType, colour])
}

model StockIn {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  skuId             String    @db.ObjectId
  sku               Sku       @relation(fields: [skuId], references: [id])
  supplierName      String
  quantityMetres    Float
  purchaseDate      DateTime
  costPricePerMetre Float
  createdById       String    @db.ObjectId
  createdAt         DateTime  @default(now())
  voidedAt          DateTime?
  voidedById        String?   @db.ObjectId
  voidReason        String?

  @@index([skuId, purchaseDate])
}

model Sale {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  skuId          String    @db.ObjectId
  sku            Sku       @relation(fields: [skuId], references: [id])
  quantityMetres Float
  pricePerMetre  Float
  saleDate       DateTime
  buyerName      String?
  createdById    String    @db.ObjectId
  createdAt      DateTime  @default(now())
  voidedAt       DateTime?
  voidedById     String?   @db.ObjectId
  voidReason     String?

  @@index([skuId, saleDate])
}

model PriceChange {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  skuId       String   @db.ObjectId
  sku         Sku      @relation(fields: [skuId], references: [id])
  oldPrice    Float?
  newPrice    Float
  changedById String   @db.ObjectId
  changedAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId   String   @db.ObjectId
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())
}
