# Database connection URL (MongoDB)
DATABASE_URL="mongodb://localhost:27017/apollo_inventory?replicaSet=rs0"

# Session encryption key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET="generate-a-secure-random-32-byte-hex-string"

# Optional public contact details displayed in portal header/footer
NEXT_PUBLIC_COMPANY_PHONE=""
NEXT_PUBLIC_COMPANY_EMAIL=""

# Production site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial user accounts for seeding (used by `npm run db:seed`)
SEED_MANAGER1_EMAIL="manager1@apollointerfabs.com"
SEED_MANAGER2_EMAIL="manager2@apollointerfabs.com"
SEED_SALES_EMAIL="sales@apollointerfabs.com"
SEED_TEMP_PASSWORD="YourSecureTemporaryPasswordHere"
